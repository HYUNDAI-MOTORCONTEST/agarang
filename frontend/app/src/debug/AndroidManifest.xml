<?xml version="1.0" encoding="utf-8"?>
<!-- debug 빌드에만 적용: 에뮬레이터 → 호스트 백엔드(10.0.2.2) HTTP 허용, 공용 컴포넌트 견본 화면, SDK 연결 확인용 권한 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 개발 확인용(sdk/PleosSdkCheck.kt, debug에서만 실행). 제출 앱(release)은 이 SDK들을 쓰지 않으므로
         main 매니페스트에는 선언하지 않는다("쓰는 권한만 선언", AGENTS.md). 공모전에서는 선언만으로 쓸 수 있다(docs/contest/rules.md 1장). -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <!-- main이 지운 FusedLocation 서비스 바인딩 권한을 debug에서만 되살린다 -->
    <uses-permission
        android:name="ai.pleos.playground.service.location.fused.FUSED_LOCATION_BINDING"
        tools:node="replace" />

    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- adb shell am start -n com.hmgchallenge.app/.ComponentGalleryActivity (런처에는 안 보인다) -->
        <activity
            android:name=".ComponentGalleryActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>
</manifest>
